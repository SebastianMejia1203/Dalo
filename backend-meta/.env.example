META_API_KEY=
META_MODEL=muse-spark-1.3-contributor
PORT=3001
# Opcional: si se define, protege definiciones, importaciones y borrados
# (cabecera x-admin-token). La validación de señas es pública sin token.
# ADMIN_TOKEN=
# Ruta de la base SQLite de validación (revisiones y sesiones de evaluación).
# ADMIN_DB_PATH=
# Valores comunes. Desarrollo: npm run dev. Producción: npm start.
# Las variables del proceso tienen prioridad sobre los archivos .env.
# Los ajustes específicos van en .env.development o .env.production.
# FFMPEG_PATH=
