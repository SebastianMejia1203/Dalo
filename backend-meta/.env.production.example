# Copiar como .env.production y completar el dominio y la clave.
# npm start selecciona producción automáticamente si NODE_ENV no está definido.
APP_ORIGIN=https://dalo.example
HOST=0.0.0.0
PORT=3001
SERVE_FRONTEND=true
# Ruta relativa a backend-meta/ o absoluta:
FRONTEND_DIST=../web-meta/dist/web-meta/browser
META_API_KEY=
META_MODEL=muse-spark-1.3-contributor
# Recomendado en producción: protege definiciones, importaciones y borrados.
# No protege la validación: cualquier persona puede validar sin token.
# Genera uno con: openssl rand -hex 32
ADMIN_TOKEN=
# Base SQLite persistente de validaciones (fuera del directorio de despliegue).
# ADMIN_DB_PATH=/ruta/persistente/dalo/admin.db
# FFMPEG_PATH=/usr/bin/ffmpeg
